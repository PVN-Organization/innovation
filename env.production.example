# ┌──────────────────────────────────────────────────────────────────┐
# │  Innovation Portal — Production (.env for portal.pvn.vn)        │
# │  Copy to .env on the APP server (10.1.8.168) before compose up. │
# └──────────────────────────────────────────────────────────────────┘
#
# Architecture:
#   App host 10.1.8.168  — Docker frontend + backend (+ temp MinIO profile)
#   DB host  10.1.8.101  — PostgreSQL (required); MinIO self-hosted (later)
#   HAProxy on app host  — https://portal.pvn.vn/sang-kien → FE/BE
#
# Start with temp MinIO until DB-host MinIO is ready:
#   docker compose --profile temp-minio up -d --build

BACKEND_HOST_PORT=10004
FRONTEND_HOST_PORT=10003

# ── PostgreSQL (on 10.1.8.101) ────────────────────────────────────
POSTGRES_ASYNC_URL=postgresql+psycopg://innovation:<DB_PASSWORD>@10.1.8.101:5432/innovation_db

# ── MinIO ─────────────────────────────────────────────────────────
# Temp (Docker on app host with --profile temp-minio):
MINIO_ENDPOINT=http://minio:9000
# Later (self-hosted on 10.1.8.101):
# MINIO_ENDPOINT=http://10.1.8.101:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=<CHANGE_ME_STRONG_PASSWORD>
MINIO_BUCKET_NAME=innovations

# ── Azure AD SSO ─────────────────────────────────────────────────
AZURE_AD_CLIENT_ID=44fb46a1-23a0-4f92-9555-d25597cd9563
AZURE_AD_TENANT_ID=f49f790c-d831-46a2-898d-27902a8b490f
AZURE_AD_CLIENT_SECRET=<YOUR_CLIENT_SECRET>
AZURE_AD_REDIRECT_URI=https://portal.pvn.vn/sang-kien/api/v1/auth/callback

# ── Backend ───────────────────────────────────────────────────────
SECRET_KEY=<CHANGE_ME_RANDOM_SECRET_64_CHARS>
DEBUG=false
BACKEND_CORS_ORIGINS=["https://portal.pvn.vn"]
FRONTEND_URL=https://portal.pvn.vn/sang-kien
COOKIE_SECURE=true
COOKIE_PATH=/sang-kien
BYPASS_AUTH_TEMP=false

# ── Frontend (bake at docker build) ───────────────────────────────
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_BASE_PATH=/sang-kien
NEXT_PUBLIC_BYPASS_AUTH_TEMP=false

# ── HAProxy (on app host — see docs/haproxy-sang-kien.snippet.cfg) ─
# /sang-kien/api/* → 127.0.0.1:10004  (strip /sang-kien)
# /sang-kien/*     → 127.0.0.1:10003  (keep prefix for Next basePath)
#
# Azure AD Redirect URI:
# https://portal.pvn.vn/sang-kien/api/v1/auth/callback
