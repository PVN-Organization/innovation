# ── Project ───────────────────────────────────────────────
PROJECT_NAME=Cổng Thông Tin Sáng Kiến Công Đoàn Petrovietnam
DEBUG=false

# ── Database (external) ───────────────────────────────────
POSTGRES_ASYNC_URL=postgresql+psycopg://innovation:password@10.1.8.101:5432/innovation_db

# ── MinIO / S3 Object Storage ─────────────────────────────
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=innovations

# ── Azure AD SSO ──────────────────────────────────────────
AZURE_AD_CLIENT_ID=
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_REDIRECT_URI=https://portal.pvn.vn/sang-kien/api/v1/auth/callback

# ── Security ──────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-secret
BACKEND_CORS_ORIGINS=["https://portal.pvn.vn"]
FRONTEND_URL=https://portal.pvn.vn/sang-kien
COOKIE_SECURE=true
COOKIE_PATH=/sang-kien
BYPASS_AUTH_TEMP=false
